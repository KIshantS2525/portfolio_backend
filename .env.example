# ---------------------------------------------------------------------------
# Gemini API keys. Gitignored — never commit this file.
# These stay server-side. Nothing here is ever sent to the browser.
# ---------------------------------------------------------------------------

# Comma-separated. Each is tried in turn and falls through on a quota or auth
# failure, so a free-tier limit on the first key won't kill the chat.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
RATE_LIMIT_PER_HOUR=20

# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# --- Admin panel (/admin) --------------------------------------------------
ADMIN_USER=
ADMIN_PASSWORD=
# Signs session tokens. Set this to a long random string in production;
# generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=
